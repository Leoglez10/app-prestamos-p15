{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "App Prestamos P15",
	"version": "0.11.0",
	"identifier": "com.p15.prestamos",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1770",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "App Prestamos P15",
				"width": 1280,
				"height": 840,
				"minWidth": 1024,
				"minHeight": 680,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5NzRFQTg2OTI4OTEyOTYKUldTV0VvbVNodXAwNmVRazdFNXhhellrNnl4dnpLOUFiRTU2QWZwNTNSdnhzNDhhK1VDZ2JJVmUK",
			"endpoints": [
				"https://github.com/Leoglez10/app-prestamos-p15/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
